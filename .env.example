# Local dev Postgres (self-hosted, installed via `winget install PostgreSQL.PostgreSQL.17`).
# Copy this file to .env and adjust for your machine / environment.
DATABASE_URL="postgresql://dmw_csm_app:dev_local_only_pw@localhost:5432/dmw_csm"

# Direct (non-pooled) connection, used only by the Prisma CLI (migrate deploy, etc.) —
# see prisma.config.ts. Required in production because it's hosted on Supabase, whose
# pooled connection (pgbouncer) can't run migrations. Not needed locally: falls back to
# DATABASE_URL above when unset, since local Postgres has no pooler.
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Used to mark cookies as Secure only in production (see lib/auth/session.ts).
NODE_ENV="development"
