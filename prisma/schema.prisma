generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  FEMALE
  MALE
}

enum CustomerType {
  CITIZEN
  BUSINESS
  GOVERNMENT
}

enum Cc1 {
  AWARE_BEFORE
  AWARE_ON_SITE
  NOT_AWARE
}

enum Cc2 {
  EASY_TO_FIND
  HARD_TO_FIND
  NOT_SEEN
}

enum Cc3 {
  USED_CC
  NOT_USED_CC
}

enum AdminRole {
  STAFF
  ADMIN
}

enum Division {
  FAD
  MWPTD
  MWPSD
  WRSD
}

enum ReportPeriodType {
  MONTH
  QUARTER
  SEMESTER
  YEAR
}

model SurveyResponse {
  id           String       @id @default(cuid())
  age          Int
  sex          Sex
  region       String
  agency       String       @default("Department of Migrant Workers (DMW) Regional Office XIII")
  division     Division
  service      String
  customerType CustomerType

  cc1       Cc1
  cc2       Cc2?
  cc3       Cc3?
  cc3Reason String?

  // Null means the respondent marked this dimension N/A (e.g. costs on a free transaction) —
  // excluded from that dimension's rating average and % rating, not counted as a low score.
  // sqd0 is a standalone overall-satisfaction question, kept separate from the SQD1-8
  // composite that ARTA's methodology is defined over.
  sqd0 Int? @db.SmallInt
  sqd1 Int? @db.SmallInt
  sqd2 Int? @db.SmallInt
  sqd3 Int? @db.SmallInt
  sqd4 Int? @db.SmallInt
  sqd5 Int? @db.SmallInt
  sqd6 Int? @db.SmallInt
  sqd7 Int? @db.SmallInt
  sqd8 Int? @db.SmallInt

  remarks   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([region])
  @@index([service])
  @@index([customerType])
  @@index([division])
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  // Null means an oversight admin who sees/manages all divisions combined.
  division     Division?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model LoginAttempt {
  username    String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// One row per public survey submission attempt, keyed by a hashed IP so raw
// addresses aren't stored alongside (otherwise-anonymous) survey responses.
// Used only to throttle spam; not joined to SurveyResponse.
model SubmissionThrottle {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}

model Report {
  id         String           @id @default(cuid())
  periodType ReportPeriodType
  year       Int
  period     Int // MONTH: 1-12, QUARTER: 1-4, SEMESTER: 1-2, YEAR: always 0
  division   Division

  // Not derivable from survey responses - entered by staff.
  serviceTransactions Json // [{ service: string, totalTransactions: number }]
  improvementPlan     Json // [{ recommendation: string, actionPlan: string, timeline: string }]

  summaryAnalysis    String?
  ccAnalysis         String?
  sqdAnalysis        String?
  actionPlanResults  String? // Section E: results of previously reported action plans
  csmRecommendations String? // Section G: recommendations for improving DMW CSM reporting

  preparedByName  String?
  preparedByTitle String?
  approvedByName  String?
  approvedByTitle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodType, year, period, division])
}

// Append-only trail for destructive/administrative actions. Written before the
// action executes so a record survives even if the action itself fails partway.
model AuditLog {
  id                  String   @id @default(cuid())
  action              String
  performedByUsername String
  performedByName     String
  details             Json?
  createdAt           DateTime @default(now())

  @@index([createdAt])
}

model ReportDownload {
  id         String           @id @default(cuid())
  periodType ReportPeriodType
  year       Int
  period     Int
  division   Division

  // Snapshots at download time, so history stays accurate if labels/admin names change later.
  periodLabel      String
  filename         String
  downloadedByName String

  downloadedAt DateTime @default(now())

  @@index([downloadedAt])
}
